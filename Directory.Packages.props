<Project>
  <PropertyGroup>
    <!--
      Default must match UmbracoAppLocalIcuVersion in Shorthand.UmbracoCodeFirst.Umbraco.csproj. Defined here too because this file
      is imported before the main project's own PropertyGroup runs, so under CPM the PackageVersion below needs
      its own fallback to stay in sync with the RuntimeHostConfigurationOption value set from the same property.
    -->
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
    <!-- Analyzer assemblies must also load in the .NET 10 SDK's Roslyn 5.0 host. -->
    <CodeFirstRoslynVersion Condition="'$(MSBuildProjectName)' == 'Shorthand.UmbracoCodeFirst.Analyzers' Or '$(MSBuildProjectName)' == 'Shorthand.UmbracoCodeFirst.SourceGenerators' Or '$(MSBuildProjectName)' == 'Shorthand.UmbracoCodeFirst.InternalSourceGenerators'">5.0.0</CodeFirstRoslynVersion>
    <CodeFirstRoslynVersion Condition="'$(CodeFirstRoslynVersion)' == ''">5.12.0</CodeFirstRoslynVersion>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <GlobalPackageReference Include="Karls.Analyzers" Version="0.4.3" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.Redis" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.SqlServer.Extensions" Version="17.0.0" />
    <PackageVersion Include="FakeItEasy.Analyzer.CSharp" Version="6.1.1" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- Umbraco 18's OpenAPI registration depends on the ASP.NET Core 10 registration shape. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[10.0.15,11.0.0)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="$(CodeFirstRoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(CodeFirstRoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeRefactoring.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(CodeFirstRoslynVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="$(UmbracoAppLocalIcuVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[18.3.2, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.3.2, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="[18.3.2, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[18.3.2, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[18.3.2, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms" Version="[18.3.2, 19.0.0)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <!-- Transitive pinnings -->
  <ItemGroup>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="System.Text.Json" Version="10.0.15" />
  </ItemGroup>
</Project>