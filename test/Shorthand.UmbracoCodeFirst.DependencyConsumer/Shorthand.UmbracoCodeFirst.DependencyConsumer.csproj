<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ConsumerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Explicitly selecting these packages is the purpose of this consumer. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shorthand.UmbracoCodeFirst" Version="$(CodeFirstPackageVersion)" />
    <PackageReference Include="Shorthand.UmbracoCodeFirst.SourceGenerators" Version="$(CodeFirstPackageVersion)" />
    <PackageReference Include="Shorthand.UmbracoCodeFirst.Analyzers" Version="$(CodeFirstPackageVersion)" />
    <PackageReference Include="Umbraco.Cms" Version="18.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="$(ConsumerExtensionsPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(ConsumerPackageVersion)" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="$(ConsumerPackageVersion)" />
    <PackageReference Include="System.Text.Json" Version="$(ConsumerPackageVersion)" />
    <Compile Include="..\Shorthand.UmbracoCodeFirst.DiagnosticsConsumer.Tests\Diagnostics.cs" Link="Diagnostics.cs" />
  </ItemGroup>
</Project>
