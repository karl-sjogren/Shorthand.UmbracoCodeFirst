<Project>
  <ItemGroup>
    <UmbracoJsonSchemaFiles Include="$(MSBuildThisFileDirectory)appsettings-schema.Shorthand.UmbracoCodeFirst.json" />
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <CompilerVisibleProperty Include="UmbracoCodeFirstViewsDirectory" />
    <CompilerVisibleProperty Include="UmbracoCodeFirstViewsTargetDirectory" />
    <CompilerVisibleProperty Include="UmbracoCodeFirstGenerateTemplates" />
    <CompilerVisibleProperty Include="UmbracoCodeFirstTemplateInputs" />
    <CompilerVisibleProperty Include="Configuration" />
  </ItemGroup>

  <PropertyGroup>
    <UmbracoCodeFirstViewsTargetDirectory Condition="'$(UmbracoCodeFirstViewsTargetDirectory)' == ''">Views</UmbracoCodeFirstViewsTargetDirectory>
    <_UmbracoCodeFirstExplicitViewsDirectory Condition="'$(UmbracoCodeFirstViewsDirectory)' != ''">true</_UmbracoCodeFirstExplicitViewsDirectory>
    <_UmbracoCodeFirstViewsDirectory Condition="'$(UmbracoCodeFirstViewsDirectory)' == ''">$(MSBuildProjectDirectory)\Views</_UmbracoCodeFirstViewsDirectory>
    <_UmbracoCodeFirstViewsDirectory Condition="'$(UmbracoCodeFirstViewsDirectory)' != ''">$(UmbracoCodeFirstViewsDirectory)</_UmbracoCodeFirstViewsDirectory>
    <_UmbracoCodeFirstViewsDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(_UmbracoCodeFirstViewsDirectory)'))</_UmbracoCodeFirstViewsDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(UmbracoCodeFirstGenerateTemplates)' != 'false'">
    <_UmbracoCodeFirstTemplateFiles Include="$(_UmbracoCodeFirstViewsDirectory)**/*.cshtml" />
    <AdditionalFiles Include="@(_UmbracoCodeFirstTemplateFiles)"
                     Exclude="@(AdditionalFiles->'%(FullPath)')"
                     TargetPath="$(UmbracoCodeFirstViewsTargetDirectory)\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="@(_UmbracoCodeFirstTemplateFiles)"
             Exclude="@(Content->'%(FullPath)')"
             Link="$(UmbracoCodeFirstViewsTargetDirectory)\%(RecursiveDir)%(Filename)%(Extension)"
             TargetPath="$(UmbracoCodeFirstViewsTargetDirectory)\%(RecursiveDir)%(Filename)%(Extension)"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromDefaultItemExcludes="true" />
  </ItemGroup>

  <Target Name="ShorthandUmbracoCodeFirstValidateRazorSettings"
          BeforeTargets="PrepareForBuild;Publish"
          Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Warning Code="UCFB001"
             Condition="'$(RazorCompileOnBuild)' == 'false'"
             Text="RazorCompileOnBuild is false. Set it to true to enable Razor source generation and IntelliSense." />
    <Warning Code="UCFB002"
             Condition="'$(RazorCompileOnPublish)' == 'false'"
             Text="RazorCompileOnPublish is false. Set it to true to compile Razor views when publishing." />
  </Target>

  <Target Name="ShorthandUmbracoCodeFirstCollectTemplates"
          BeforeTargets="PrepareForBuild;AssignTargetPaths;GenerateMSBuildEditorConfigFileCore;CoreCompile">
    <PropertyGroup>
      <_UmbracoCodeFirstExplicitViewsDirectory Condition="'$(UmbracoCodeFirstViewsDirectory)' != ''">true</_UmbracoCodeFirstExplicitViewsDirectory>
      <_UmbracoCodeFirstViewsDirectory Condition="'$(UmbracoCodeFirstViewsDirectory)' == ''">$(MSBuildProjectDirectory)\Views</_UmbracoCodeFirstViewsDirectory>
      <_UmbracoCodeFirstViewsDirectory Condition="'$(UmbracoCodeFirstViewsDirectory)' != ''">$(UmbracoCodeFirstViewsDirectory)</_UmbracoCodeFirstViewsDirectory>
      <_UmbracoCodeFirstViewsDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(_UmbracoCodeFirstViewsDirectory)'))</_UmbracoCodeFirstViewsDirectory>
    </PropertyGroup>
    <Error Condition="'$(UmbracoCodeFirstGenerateTemplates)' != 'false' and '$(_UmbracoCodeFirstExplicitViewsDirectory)' == 'true' and !Exists('$(_UmbracoCodeFirstViewsDirectory)')"
           Text="UmbracoCodeFirstViewsDirectory '$(_UmbracoCodeFirstViewsDirectory)' does not exist." />
    <PropertyGroup>
      <UmbracoCodeFirstTemplateInputs>@(_UmbracoCodeFirstTemplateFiles->'%(FullPath)')</UmbracoCodeFirstTemplateInputs>
    </PropertyGroup>
  </Target>
</Project>
